// Pure rendering. Positions, sizes and states are computed by main.rs (layout.rs),
// so that picture and hit testing match exactly.

export struct WidgetData {
    kind: int,          // 0 button, 1 toggle, 2 slider, 3 display
    x: length,
    y: length,
    w: length,
    h: length,
    label: string,
    text: string,       // display: output, slider: value as text
    value: float,       // Slider: 0..1
    on: bool,           // Toggle
    pressed: bool,
    armed: bool,        // waiting for the second tap (confirm)
    accent: color,
}

export component Overlay inherits Window {
    // Target progress 0 (closed) to 1 (open)
    in property <float> progress: 0;
    // A finger is moving the panel: then follow without delay, otherwise glide to the target
    in property <bool> dragging: false;
    // Duration of the transitions; 0 turns animations off
    in property <duration> anim: 220ms;
    // Panel in the open state and offset in the closed one (off screen)
    in property <length> panel-x;
    in property <length> panel-y;
    in property <length> panel-w: 400px;
    in property <length> panel-h: 400px;
    in property <length> slide-x;
    in property <length> slide-y;
    in property <length> pad: 24px;
    in property <length> header-h: 64px;
    in property <string> heading;
    in property <string> error;
    in property <bool> has-close: true;
    in property <length> close-x;
    in property <length> close-y;
    in property <length> close-w;
    in property <length> close-h;
    in property <bool> close-pressed: false;
    in property <[WidgetData]> widgets;

    in property <color> panel-color: #171a21f5;
    in property <float> dim: 0.55;
    in property <color> text-color: #f2f2f7;
    in property <color> muted-color: #9aa0ad;
    in property <color> widget-color: #252a35;
    in property <color> pressed-color: #3a4150;
    in property <color> accent-color: #4d9fff;
    in property <color> border-color: #ffffff14;
    in property <length> border-w: 1px;
    in property <length> radius: 14px;
    in property <length> font-size: 22px;

    // Edge hint: finger in the start zone of the gesture (window coordinates)
    in property <bool> hint-on: false;
    in property <int> hint-dir: 1;          // 0 left, 1 right, 2 top, 3 bottom, 4 corner
    in property <length> hint-thick: 40px;  // strip width or radius of the corner glow
    in property <length> hint-x;
    in property <length> hint-y;
    in property <length> hint-cx;           // corner (only hint-dir 4)
    in property <length> hint-cy;

    in property <bool> show-touches: false;
    in property <int> touch-count: 0;
    in property <[float]> touches;          // x0, y0, x1, y1, ... (window coordinates)

    background: transparent;

    // Visible progress: follows `progress`, gliding on release and on open/close.
    // All transitions depend on this alone.
    property <float> shown: root.progress;
    animate shown {
        duration: root.dragging ? 0ms : root.anim;
        easing: ease-out-quart;
    }
    // Content appears in the second half so that the panel arrives first
    property <float> content: clamp((root.shown - 0.35) / 0.65, 0, 1);

    Rectangle {
        background: rgba(0, 0, 0, root.dim * root.shown);
    }

    Rectangle {
        visible: root.shown > 0.001;
        x: root.panel-x + root.slide-x * (1 - root.shown);
        y: root.panel-y + root.slide-y * (1 - root.shown);
        width: root.panel-w;
        height: root.panel-h;
        background: root.panel-color;
        opacity: min(1, root.shown * 2);
        drop-shadow-blur: 24px;
        drop-shadow-color: rgba(0, 0, 0, 0.45);

        // Content fades in and trails the panel slightly
        Rectangle {
            x: root.slide-x * 0.08 * (1 - root.content);
            y: root.slide-y * 0.08 * (1 - root.content);
            width: parent.width;
            height: parent.height;
            opacity: root.content;

            if root.heading != "" : Text {
                x: root.pad;
                y: root.pad;
                width: (root.has-close ? root.close-x - root.pad : parent.width - root.pad) - root.pad;
                height: root.header-h;
                text: root.heading;
                font-size: root.font-size * 1.6;
                font-weight: 700;
                color: root.text-color;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.has-close : Rectangle {
                x: root.close-x;
                y: root.close-y;
                width: root.close-w;
                height: root.close-h;
                border-radius: root.radius;
                background: root.close-pressed ? root.pressed-color : root.widget-color;
                animate background { duration: root.anim * 0.4; }
                border-width: root.border-w;
                border-color: root.border-color;
                Text {
                    text: "✕";
                    font-size: root.font-size * 1.2;
                    color: root.text-color;
                }
            }

            for w in root.widgets : Rectangle {
                x: w.x;
                y: w.y;
                width: w.w;
                height: w.h;
                border-radius: root.radius;
                border-width: root.border-w;
                border-color: root.border-color;
                background: w.pressed ? root.pressed-color
                    : w.armed ? w.accent.with-alpha(0.45) : root.widget-color;
                animate background { duration: root.anim * 0.4; }
                clip: true;

                // Slider: fill
                if w.kind == 2 : Rectangle {
                    x: 0;
                    width: parent.width * w.value;
                    background: w.accent.with-alpha(0.55);
                }

                // Button: centered label
                if w.kind == 0 : Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: w.label;
                    font-size: root.font-size;
                    color: root.text-color;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                // Toggle and slider: label on the left
                if w.kind == 1 || w.kind == 2 : Text {
                    x: 16px;
                    width: parent.width - 32px - (w.kind == 1 ? root.font-size * 2.6 : root.font-size * 3.5);
                    text: w.label;
                    font-size: root.font-size;
                    color: root.text-color;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // Toggle: switch on the right
                if w.kind == 1 : Rectangle {
                    width: root.font-size * 2.2;
                    height: root.font-size * 1.2;
                    x: parent.width - self.width - 16px;
                    border-radius: self.height / 2;
                    background: w.on ? w.accent : root.pressed-color;
                    animate background { duration: root.anim * 0.7; }
                    Rectangle {
                        width: parent.height - 6px;
                        height: self.width;
                        x: w.on ? parent.width - self.width - 3px : 3px;
                        animate x { duration: root.anim * 0.7; easing: ease-out-quad; }
                        border-radius: self.width / 2;
                        background: root.text-color;
                    }
                }

                // Slider: value on the right
                if w.kind == 2 : Text {
                    x: parent.width - root.font-size * 3.5 - 16px;
                    width: root.font-size * 3.5;
                    text: w.text;
                    font-size: root.font-size;
                    color: root.text-color;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                // Display: small label on top, large value below
                if w.kind == 3 : VerticalLayout {
                    padding: 14px;
                    alignment: center;
                    spacing: 4px;
                    if w.label != "" : Text {
                        text: w.label;
                        font-size: root.font-size * 0.7;
                        color: root.muted-color;
                        overflow: elide;
                    }
                    Text {
                        text: w.text;
                        font-size: root.font-size * 1.3;
                        font-weight: 600;
                        color: root.text-color;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }

            // Config error last so that it lies above the widgets
            if root.error != "" : Rectangle {
                x: root.pad;
                y: parent.height - self.height - root.pad;
                width: parent.width - 2 * root.pad;
                height: err-text.preferred-height + 16px;
                border-radius: root.radius;
                background: #8f2a2ef0;
                err-text := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: root.error;
                    font-size: root.font-size * 0.7;
                    color: white;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Glowing strip at the edge while a finger is in the start zone. Shows that the edge
    // was recognized and where the other fingers belong.
    property <float> hint-shown: root.hint-on ? 1 : 0;
    animate hint-shown {
        duration: root.hint-on ? 120ms : 280ms;
        easing: ease-out-quad;
    }
    property <color> hint-glow: root.accent-color.with-alpha(0.45);
    property <length> mark: 160px;          // length of the mark at the finger
    // While dragging it fades out as the panel comes in.
    property <float> hint-alpha: root.hint-shown * clamp(1 - root.shown * 4, 0, 1);
    if root.hint-alpha > 0.001 : Rectangle {
        opacity: root.hint-alpha;

        if root.hint-dir == 0 : Rectangle {
            width: root.hint-thick;
            background: @linear-gradient(270deg, root.accent-color.with-alpha(0) 0%, root.hint-glow 100%);
        }
        if root.hint-dir == 1 : Rectangle {
            x: parent.width - root.hint-thick;
            width: root.hint-thick;
            background: @linear-gradient(90deg, root.accent-color.with-alpha(0) 0%, root.hint-glow 100%);
        }
        if root.hint-dir == 2 : Rectangle {
            height: root.hint-thick;
            background: @linear-gradient(0deg, root.accent-color.with-alpha(0) 0%, root.hint-glow 100%);
        }
        if root.hint-dir == 3 : Rectangle {
            y: parent.height - root.hint-thick;
            height: root.hint-thick;
            background: @linear-gradient(180deg, root.accent-color.with-alpha(0) 0%, root.hint-glow 100%);
        }
        if root.hint-dir == 4 : Rectangle {
            x: root.hint-cx - root.hint-thick;
            y: root.hint-cy - root.hint-thick;
            width: root.hint-thick * 2;
            height: root.hint-thick * 2;
            border-radius: root.hint-thick;
            background: @radial-gradient(circle, root.accent-color.with-alpha(0.7) 0%, root.accent-color.with-alpha(0) 70%);
        }

        // Bright mark right at the edge, level with the finger
        if root.hint-dir <= 1 : Rectangle {
            x: root.hint-dir == 1 ? parent.width - 6px : 0;
            y: clamp(root.hint-y - root.mark / 2, 0, parent.height - root.mark);
            width: 6px;
            height: root.mark;
            border-radius: 3px;
            background: root.accent-color;
        }
        if root.hint-dir == 2 || root.hint-dir == 3 : Rectangle {
            x: clamp(root.hint-x - root.mark / 2, 0, parent.width - root.mark);
            y: root.hint-dir == 3 ? parent.height - 6px : 0;
            width: root.mark;
            height: 6px;
            border-radius: 3px;
            background: root.accent-color;
        }
    }

    if root.show-touches : Rectangle {
        for i in root.touch-count : Rectangle {
            x: root.touches[i * 2] * 1px - 30px;
            y: root.touches[i * 2 + 1] * 1px - 30px;
            width: 60px;
            height: 60px;
            border-radius: 30px;
            background: root.accent-color.with-alpha(0.5);
        }
    }
}
